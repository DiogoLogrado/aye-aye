{
  "name": "aye-aye",
  "version": "0.1.0",
  "private": true,
  "description": "A local MongoDB browser with a visual query builder. Every change is previewed, backed up and can be undone.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts --prod",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "build:app": "npm run build && esbuild electron/main.ts --bundle --platform=node --format=esm --target=node24 --packages=external --sourcemap --outfile=dist/electron/main.mjs && esbuild electron/preload.ts --bundle --platform=node --format=cjs --target=node24 --external:electron --outfile=dist/electron/preload.cjs",
    "app": "npm run build:app && node scripts/launch-electron.mjs",
    "app:smoke": "npm run build:app && node scripts/launch-electron.mjs --smoke-test",
    "icons": "node scripts/build-icons.mjs",
    "dist": "npm run build:app && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@napi-rs/keyring": "^1.3.0",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "mongodb": "^7.8.0",
    "mongodb-query-parser": "^4.7.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "44.9.3",
    "electron-builder": "26.18.0",
    "esbuild": "0.25.12",
    "lucide-react": "1.60.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.5"
  },
  "main": "dist/electron/main.mjs",
  "author": "The Aye-aye contributors",
  "build": {
    "appId": "local.aye-aye",
    "productName": "Aye-aye",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "assets/icon.ico",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Aye-aye",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Aye-aye-Setup-${version}.exe"
    },
    "publish": null,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    }
  }
}
